rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // L'iPad de Sana peut AJOUTER des séances (jamais lire, modifier ou supprimer).
    match /sessions/{id} {
      allow create: if request.resource.data.keys().hasOnly(
          ['name','mode','level','startedAt','durationSec','answered','correct','firstTry','points','skills'])
        && request.resource.data.answered is int && request.resource.data.answered <= 60
        && request.resource.data.correct is int && request.resource.data.correct <= 60;
      allow read: if request.auth != null;   // uniquement le parent connecté
      allow update, delete: if false;
    }

    // Récompenses choisies par le parent : lisibles par l'appli, modifiables seulement par le parent connecté.
    match /config/rewards {
      allow read: if true;
      allow write: if request.auth != null && request.resource.data.keys().hasOnly(['items']);
    }

    match /state/sana {
      allow create, update: if request.resource.data.keys().hasOnly(['points','streak','house','level','lastSeen','unlocked','review']);
      allow read: if request.auth != null;
      allow delete: if false;
    }
  }
}
